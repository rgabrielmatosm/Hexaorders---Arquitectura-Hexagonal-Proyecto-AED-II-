      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_sum{uri=\"/api/shop/orders\",method=\"POST\"}[5m])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/shop/orders\",method=\"POST\"}[5m]))",
