      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{job=\"order-api\"})",
          "legendFormat": "activas"
        },
        {
          "refId": "B",
          "expr": "sum(hikaricp_connections_idle{job=\"order-api\"})",
          "legendFormat": "inactivas"
        },
        {
          "refId": "C",
          "expr": "sum(hikaricp_connections_pending{job=\"order-api\"})",
          "legendFormat": "en espera"
        },
        {
          "refId": "D",
          "expr": "sum(hikaricp_connections_max{job=\"order-api\"})",
          "legendFormat": "máximo"
        }
