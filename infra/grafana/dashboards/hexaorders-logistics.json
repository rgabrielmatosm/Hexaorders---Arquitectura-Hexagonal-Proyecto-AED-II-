{
  "id": null,
  "uid": "hexaorders-logistics",
  "title": "HexaOrders — Logistics Operations",
  "description": "Tramo logístico del ciclo de vida: pedidos listos, en tránsito y entregados, programación, conflictos de agenda e incidencias. Fuente: métricas hexaorders_* de order-api (v4).",
  "tags": [
    "hexaorders",
    "logistics",
    "v4"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
