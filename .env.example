# POLYMER — configuración NO sensible (plantilla). Copia este archivo como .env solo si lo necesitas.
# .env está excluido de Git. NUNCA pongas contraseñas aquí: las contraseñas son archivos en secrets\
# (Docker Secrets), ver docs/SECRETOS.md y secrets.example/.
#
# En local (Windows + Docker Desktop) NO hace falta ningún .env: docker-compose.yml funciona tal cual.

# --- Despliegue en AWS (infra/aws/compose.aws.yml + Nginx del host) -------------------------------
# Dominio de la tienda y subdominio de Grafana (registros A hacia la IP elástica de la instancia).
POLYMER_DOMAIN=tienda.ejemplo.com
POLYMER_GRAFANA_DOMAIN=grafana.ejemplo.com
# Correo para los avisos de caducidad de Let's Encrypt (certbot).
LETSENCRYPT_EMAIL=admin@ejemplo.com
# Copias de seguridad (infra/aws/backup.sh): carpeta local y, opcionalmente, bucket S3 (sin credenciales:
# la instancia usa su rol IAM).
POLYMER_BACKUP_DIR=/var/backups/polymer
POLYMER_BACKUP_S3=
POLYMER_BACKUP_KEEP=14

# --- v7 · Correo real (Gmail u otro relé SMTP). Vacío = Mailpit (captura local en http://127.0.0.1:8025) ----
# Gmail: activa la verificación en 2 pasos de la cuenta, crea una «contraseña de aplicación» y pégala en
# secrets\smtp_password.txt (NO aquí). Ver docs/final/GUIA_GOOGLE_Y_PAGOS.md, sección 2.
# POLYMER_SMTP_HOST=smtp.gmail.com
# POLYMER_SMTP_PORT=587
# POLYMER_SMTP_USERNAME=tu.cuenta@gmail.com
# POLYMER_SMTP_STARTTLS=true
# POLYMER_MAIL_FROM=POLYMER <tu.cuenta@gmail.com>
# Origen público de la tienda para los enlaces de los correos (boleta, seguimiento).
# POLYMER_PUBLIC_URL=http://localhost:8080

# --- v7 · «Continuar con Google»: client id y secret van en secrets\google_client_id.txt y
# secrets\google_client_secret.txt (vacíos = botón oculto). URI de redirección autorizada en Google Cloud:
#   http://localhost:8080/login/oauth2/code/google   (y https://TU_DOMINIO/login/oauth2/code/google en AWS)

# --- v7 · Tienda física (mapa de Google Maps, horario de hoy) y Google Calendar público opcional ---------
# Dirección de DEMOSTRACIÓN por defecto: cámbiala por la real. Las coordenadas fijan el pin del mapa.
# POLYMER_STORE_ADDRESS=Av. Javier Prado Este 4200
# POLYMER_STORE_DISTRICT=Santiago de Surco
# POLYMER_STORE_LATITUDE=-12.0853
# POLYMER_STORE_LONGITUDE=-76.9753
# ID de un calendario PÚBLICO de Google Calendar (Configuración del calendario → Integrar el calendario).
# POLYMER_GOOGLE_CALENDAR_ID=xxxxxxxxxxxxxxxx@group.calendar.google.com

# --- Modo demostración (lo gestiona .\polymer.cmd demo-on / demo-off; no hace falta tocarlo) ---------
# POLYMER_DEMO_CACHE_TTL=20s
# POLYMER_DEMO_RISK_ADAPTER=http
# POLYMER_DEMO_FIXED_SCORE=10
