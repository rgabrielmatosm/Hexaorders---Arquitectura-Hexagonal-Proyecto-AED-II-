# POLYMER — configuración NO sensible (plantilla). Copia este archivo como .env solo si lo necesitas.
# .env está excluido de Git. NUNCA pongas contraseñas aquí: las contraseñas son archivos en secrets\
# (Docker Secrets), ver docs/SECRETOS.md y secrets.example/.
#
# En local (Windows + Docker Desktop) NO hace falta ningún .env: docker-compose.yml funciona tal cual.

# --- Despliegue en AWS (infra/aws/compose.aws.yml + Nginx del host) -------------------------------
# Dominio de la tienda y subdominio de Grafana (registros A hacia la IP elástica de la instancia).
POLYMER_DOMAIN=tienda.ejemplo.com
POLYMER_GRAFANA_DOMAIN=grafana.ejemplo.com
# Correo para los avisos de caducidad de Let's Encrypt (certbot).
LETSENCRYPT_EMAIL=admin@ejemplo.com
# Copias de seguridad (infra/aws/backup.sh): carpeta local y, opcionalmente, bucket S3 (sin credenciales:
# la instancia usa su rol IAM).
POLYMER_BACKUP_DIR=/var/backups/polymer
POLYMER_BACKUP_S3=
POLYMER_BACKUP_KEEP=14

# --- Modo demostración (lo gestiona .\polymer.cmd demo-on / demo-off; no hace falta tocarlo) ---------
# POLYMER_DEMO_CACHE_TTL=20s
# POLYMER_DEMO_RISK_ADAPTER=http
# POLYMER_DEMO_FIXED_SCORE=10
