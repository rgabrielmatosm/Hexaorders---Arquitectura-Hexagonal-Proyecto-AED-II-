{
  "info": {
    "name": "POLYMER — Order Management & Risk Assessment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demostración de la API de POLYMER. Ejecuta las peticiones en orden con el stack levantado (.\\polymer.cmd start). Las pruebas comprueban los resultados esperados según el código; no fuerzan ningún resultado."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Pedido aprobado (125.50 → riesgo 10)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "description": "Importe < 500: el motor Python devuelve 10; el dominio Java decide APPROVED.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"demo_postman\",\n  \"amount\": 125.5,\n  \"currency\": \"USD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const order = pm.response.json();",
              "pm.test('riskScore 10 y estado APPROVED', () => { pm.expect(order.riskScore).to.eql(10); pm.expect(order.status).to.eql('APPROVED'); });",
              "pm.test('Cabecera Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/orders/' + order.id));",
              "pm.collectionVariables.set('orderId', order.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Pedido aprobado (750.00 → riesgo 40)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "description": "Importe entre 500 y 999.99: riesgo 40.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"demo_postman\",\n  \"amount\": 750.0,\n  \"currency\": \"USD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const order = pm.response.json();",
              "pm.test('riskScore 40 y estado APPROVED', () => { pm.expect(order.riskScore).to.eql(40); pm.expect(order.status).to.eql('APPROVED'); });",
              "pm.test('Cabecera Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/orders/' + order.id));",
              "pm.collectionVariables.set('orderId', order.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Pedido en revisión (1500.00 → riesgo 75)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "description": "Importe ≥ 1000: riesgo 75 ≥ 70 → REVIEW.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"demo_postman\",\n  \"amount\": 1500.0,\n  \"currency\": \"USD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const order = pm.response.json();",
              "pm.test('riskScore 75 y estado REVIEW', () => { pm.expect(order.riskScore).to.eql(75); pm.expect(order.status).to.eql('REVIEW'); });",
              "pm.test('Cabecera Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/orders/' + order.id));",
              "pm.collectionVariables.set('orderId', order.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Consultar el último pedido por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{orderId}}"
          ]
        },
        "description": "Lectura desde PostgreSQL."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Es el pedido creado', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Listar últimos pedidos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Como máximo 50', () => pm.expect(pm.response.json().length).to.be.at.most(50));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Estadísticas persistentes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/statistics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "statistics"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const s = pm.response.json();",
              "pm.test('total = approved + review', () => pm.expect(s.total).to.eql(s.approved + s.review));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Validación: importe con 3 decimales → 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "description": "El dominio rechaza el importe; no se guarda nada.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"demo_postman\",\n  \"amount\": 10.001,\n  \"currency\": \"USD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('ProblemDetail', () => pm.expect(pm.response.json().title).to.eql('Solicitud inválida'));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Validación: cliente con caracteres no permitidos → 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"demo cliente!\",\n  \"amount\": 10,\n  \"currency\": \"USD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Pedido inexistente → 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/00000000-0000-0000-0000-000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "00000000-0000-0000-0000-000000000000"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Con risk-engine detenido → 503 (ejecutar tras docker compose stop risk-engine)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "description": "Antes: docker compose stop risk-engine. Después: docker compose start risk-engine. Comprueba con la petición 6 que el total no cambió.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"demo_fallo\",\n  \"amount\": 125.5,\n  \"currency\": \"USD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('503 Service Unavailable', () => pm.response.to.have.status(503));",
              "pm.test('Motor de riesgo no disponible', () => pm.expect(pm.response.json().title).to.eql('Motor de riesgo no disponible'));"
            ]
          }
        }
      ]
    }
  ]
}
